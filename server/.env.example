# Server configuration (set these in EasyPanel for production)

# Owner login for the /admin panel
OWNER_EMAIL=admin@anabeatriznail.com.br
# Provide a plaintext password (hashed on boot) OR a precomputed bcrypt hash.
OWNER_PASSWORD=troque-esta-senha
# OWNER_PASSWORD_HASH=$2a$10$....

# Secret used to sign admin session JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Where the SQLite DB and uploads live (mount a persistent volume here)
DATA_DIR=/data

# Port the server listens on
PORT=3000
NODE_ENV=production

# Public URL of the site (used for the OpenRouter referer header)
PUBLIC_URL=https://www.anabeatriznail.com.br

# Set to true ONLY after you add HTTPS via EasyPanel domain (Secure cookie flag).
# Leave unset or false for HTTP test environments.
# COOKIE_SECURE=true

# ---- AI nail try-on (OpenRouter + Gemini) ----
# Required to enable the "Espelho do Futuro" image generation on the site.
OPENROUTER_API_KEY=sk-or-...
# Optional overrides (sensible defaults shown):
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# AI_MONTHLY_LIMIT=200       # max generations per calendar month (global)
# NAIL_PERSON_LIMIT=3        # max generations per visitor (silent cap)
# AI_IMAGE_TIMEOUT_MS=90000
